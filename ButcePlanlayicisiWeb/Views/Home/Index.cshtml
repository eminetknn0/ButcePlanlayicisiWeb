@model List<ButcePlanlayicisiWeb.Models.ButceKaydi>

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Bütçe Planlayıcısı</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f6f8;
            margin: 0;
            padding: 30px;
        }

        .container {
            max-width: 1100px;
            margin: auto;
        }

        h1 {
            text-align: center;
            margin-bottom: 30px;
        }

        .kartlar {
            display: flex;
            gap: 20px;
            margin-bottom: 30px;
        }

        .kart {
            flex: 1;
            padding: 20px;
            border-radius: 12px;
            background: white;
            text-align: center;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        .gelir {
            border-top: 5px solid #28a745;
        }

        .gider {
            border-top: 5px solid #dc3545;
        }

        .bakiye {
            border-top: 5px solid #007bff;
        }

        .form {
            background: white;
            padding: 20px;
            border-radius: 12px;
            margin-bottom: 30px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        input, select, button {
            padding: 10px;
            margin: 5px;
            border-radius: 6px;
            border: 1px solid #ccc;
        }

        button {
            background-color: #007bff;
            color: white;
            border: none;
            cursor: pointer;
        }

        button:hover {
            background-color: #0056b3;
        }

        table {
            width: 100%;
            border-collapse: collapse;
            background: white;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        th, td {
            padding: 12px;
            border-bottom: 1px solid #ddd;
            text-align: center;
        }

        th {
            background-color: #343a40;
            color: white;
        }

        .sil {
            background-color: #dc3545;
        }

        .sil:hover {
            background-color: #a71d2a;
        }

        .guncelle {
            background-color: #ffc107;
            color: black;
            padding: 10px 15px;
            border-radius: 6px;
            text-decoration: none;
            margin-right: 5px;
        }

            .guncelle:hover {
                background-color: #e0a800;
            }
        .tum-kayitlar {
            display: inline-block;
            padding: 10px 15px;
            margin: 5px;
            background-color: #6c757d;
            color: white;
            border-radius: 6px;
            text-decoration: none;
        }
        .raporlar-btn {
    display: block;
    width: fit-content;
    margin: 0 auto 25px auto;
    padding: 12px 20px;
    background-color: #6f42c1;
    color: white;
    text-decoration: none;
    border-radius: 8px;
}

.raporlar-btn:hover {
    background-color: #59339d;
}
            .tum-kayitlar:hover {
                background-color: #545b62;
            }
    </style>
</head>

<body>

    <div class="container">

       
        <h1>💰 Bütçe Planlayıcısı</h1>

        <a href="/Home/Raporlar" class="raporlar-btn">
            📊 Raporlar
        </a>
        @{
            double toplamGelir = Model.Sum(x => x.Gelir);
            double toplamGider = Model.Sum(x => x.Gider);
            double bakiye = toplamGelir - toplamGider;
        }
        
        <div class="kartlar">

            <div class="kart gelir">
                <h3>Toplam Gelir</h3>
                <h2>@toplamGelir.ToString("N2") TL</h2>
            </div>

            <div class="kart gider">
                <h3>Toplam Gider</h3>
                <h2>@toplamGider.ToString("N2") TL</h2>
            </div>

            <div class="kart bakiye">
                <h3>Bakiye</h3>
                <h2>@bakiye.ToString("N2") TL</h2>
            </div>

        </div>  

        <div class="form">

            <h2>🔎 Kategori Filtrele</h2>

            <form asp-action="Filtrele" method="get">

                <select name="kategori">
                    <option value="">Kategori Seçiniz</option>
                    <option>Maaş</option>
                    <option>Burs</option>
                    <option>Harçlık</option>
                    <option>Ek Gelir</option>
                    <option>Market</option>
                    <option>Kira</option>
                    <option>Fatura</option>
                    <option>Ulaşım</option>
                    <option>Yemek</option>
                    <option>Sağlık</option>
                    <option>Eğitim</option>
                    <option>Giyim</option>
                    <option>Eğlence</option>
                    <option>Alışveriş</option>
                    <option>İnternet</option>
                    <option>Telefon</option>
                    <option>Yakıt</option>
                    <option>Diğer</option>
                </select>

              <button type="submit">Filtrele</button>

               <a href="/" class="tum-kayitlar">
                   Tüm Kayıtları Göster
                 </a>
               

            </form>

        </div>

        <div class="form">

            <h2>Yeni Kayıt Ekle</h2>

            <form asp-action="Ekle" method="post">

                <input type="number"
                       step="0.01"
                       name="Gelir"
                       placeholder="Gelir TL" />

                <input type="number"
                       step="0.01"
                       name="Gider"
                       placeholder="Gider TL" />

                <select name="Kategori">
                    <option value="">Kategori Seçiniz</option>
                    <option>Maaş</option>
                    <option>Burs</option>
                    <option>Harçlık</option>
                    <option>Ek Gelir</option>
                    <option>Market</option>
                    <option>Kira</option>
                    <option>Fatura</option>
                    <option>Ulaşım</option>
                    <option>Yemek</option>
                    <option>Sağlık</option>
                    <option>Eğitim</option>
                    <option>Giyim</option>
                    <option>Eğlence</option>
                    <option>Alışveriş</option>
                    <option>İnternet</option>
                    <option>Telefon</option>
                    <option>Yakıt</option>
                    <option>Diğer</option>
                </select>

                <input type="date" name="Tarih" />

                <button type="submit">Kayıt Ekle</button>

            </form>

        </div>

        <h2>Kayıtlar</h2>

        <table>

            <thead>
                <tr>
                    <th>Gelir</th>
                    <th>Gider</th>
                    <th>Kategori</th>
                    <th>Tarih</th>
                    <th>İşlem</th>
                </tr>
            </thead>

            <tbody>

                @foreach (var kayit in Model)
                {
                    <tr>
                        <td>@kayit.Gelir.ToString("N2") TL</td>
                        <td>@kayit.Gider.ToString("N2") TL</td>
                        <td>@kayit.Kategori</td>
                        <td>@kayit.Tarih.ToString("dd.MM.yyyy")</td>

                        <td>
                            <a asp-action="Duzenle"
                               asp-route-id="@kayit.Id"
                               class="guncelle">
                                Güncelle
                            </a>

                            <a asp-action="Sil"
                               asp-route-id="@kayit.Id"
                               class="sil">
                                Sil
                            </a>
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</body>
</html>
    