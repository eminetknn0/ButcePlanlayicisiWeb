@model ButcePlanlayicisiWeb.Models.ButceKaydi

<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Kayıt Güncelle</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #f4f6f8;
            padding: 30px;
        }

        .form {
            max-width: 600px;
            margin: 50px auto;
            background: white;
            padding: 30px;
            border-radius: 12px;
            box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        }

        input, select, button {
            width: 100%;
            padding: 12px;
            margin: 8px 0;
            border-radius: 6px;
            border: 1px solid #ccc;
            box-sizing: border-box;
        }

        button {
            background-color: #007bff;
            color: white;
            border: none;
            cursor: pointer;
        }

            button:hover {
                background-color: #0056b3;
            }

        .geri {
            display: block;
            text-align: center;
            margin-top: 15px;
            text-decoration: none;
        }
    </style>
</head>

<body>

    <div class="form">

        <h1>✏️ Kayıt Güncelle</h1>

        <form asp-action="Duzenle" method="post">

            <input type="hidden" name="Id" value="@Model.Id" />

            <label>Gelir</label>
            <input type="number"
                   step="0.01"
                   name="Gelir"
                   value="@Model.Gelir" />

            <label>Gider</label>
            <input type="number"
                   step="0.01"
                   name="Gider"
                   value="@Model.Gider" />

            <label>Kategori</label>

            <select name="Kategori">

                <option value="">Kategori Seçiniz</option>

                <option selected="@(Model.Kategori == "Maaş")">Maaş</option>
                <option selected="@(Model.Kategori == "Burs")">Burs</option>
                <option selected="@(Model.Kategori == "Harçlık")">Harçlık</option>
                <option selected="@(Model.Kategori == "Ek Gelir")">Ek Gelir</option>
                <option selected="@(Model.Kategori == "Market")">Market</option>
                <option selected="@(Model.Kategori == "Kira")">Kira</option>
                <option selected="@(Model.Kategori == "Fatura")">Fatura</option>
                <option selected="@(Model.Kategori == "Ulaşım")">Ulaşım</option>
                <option selected="@(Model.Kategori == "Yemek")">Yemek</option>
                <option selected="@(Model.Kategori == "Sağlık")">Sağlık</option>
                <option selected="@(Model.Kategori == "Eğitim")">Eğitim</option>
                <option selected="@(Model.Kategori == "Giyim")">Giyim</option>
                <option selected="@(Model.Kategori == "Eğlence")">Eğlence</option>
                <option selected="@(Model.Kategori == "Alışveriş")">Alışveriş</option>
                <option selected="@(Model.Kategori == "İnternet")">İnternet</option>
                <option selected="@(Model.Kategori == "Telefon")">Telefon</option>
                <option selected="@(Model.Kategori == "Yakıt")">Yakıt</option>
                <option selected="@(Model.Kategori == "Diğer")">Diğer</option>

            </select>

            <label>Tarih</label>

            <input type="date"
                   name="Tarih"
                   value="@Model.Tarih.ToString("yyyy-MM-dd")" />

            <button type="submit">
                Güncelle
            </button>

        </form>

        <a href="/" class="geri">
            ← Ana Sayfaya Dön
        </a>

    </div>

</body>
</html>   